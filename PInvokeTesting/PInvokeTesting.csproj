<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- C# 8 shipped with .NET Core 3.x, what this project targeted in 2020.
         The runtime is newer (3.1 is out of support), so the API surface is kept
         to what 3.1 had by hand; see TIMELINE.md. -->
    <LangVersion>8.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Benchmarks\" />
    <Folder Include="Native\" />
  </ItemGroup>
  <!-- Run cargo build in release mode in ../rust first. -->
  <ItemGroup>
    <None Include="../rust/target/release/libffi_test.dylib" Link="libffi_test.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
