<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- C# 15 / .NET 11 are in preview; global.json pins the SDK. `preview`
         gives the new syntax, and the feature flag turns on the updated memory
         safety rules: `unsafe` on a member obliges its callers. -->
    <LangVersion>preview</LangVersion>
    <Features>$(Features);updated-memory-safety-rules</Features>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Benchmarks\" />
    <Folder Include="Native\" />
  </ItemGroup>
  <!-- `dotnet publish -r osx-arm64` compiles ahead of time and links the Rust
       archive into the executable: calls to ffi_test become direct calls, and
       there is no dylib to ship or find. `dotnet run` still uses the dylib. -->
  <!-- Only when publishing for a runtime: PublishAot also writes NativeAOT's
       feature switches (no dynamic code, no reflection-based JSON) into every
       build's runtimeconfig, which would make `dotnet run` act as if it were AOT. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!-- BenchmarkDotNet needs the JIT, so it stays out of the NativeAOT build. -->
  <PropertyGroup Condition="'$(PublishAot)' != 'true'">
    <DefineConstants>$(DefineConstants);BENCHMARKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Compile Remove="Benchmarks/InsertBenchmarks.cs" />
  </ItemGroup>
  <ItemGroup>
    <DirectPInvoke Include="ffi_test" />
    <NativeLibrary Include="../rust/target/release/libffi_test.a" />
  </ItemGroup>
  <!-- Run cargo build in release mode in ../rust first. -->
  <ItemGroup>
    <None Include="../rust/target/release/libffi_test.dylib" Link="libffi_test.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../rust/target/release/ffi_test_bin" Link="ffi_test_bin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
