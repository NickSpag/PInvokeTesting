<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Benchmarks\" />
    <Folder Include="Native\" />
  </ItemGroup>
  <!-- Run cargo build in release mode in ../rust first. -->
  <ItemGroup>
    <None Include="../rust/target/release/libffi_test.dylib" Link="libffi_test.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
